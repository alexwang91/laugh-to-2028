    "hac": {
      "kernel": "BARTLETT_NEWEY_WEST",
      "max_lag": 19,
      "gamma_k": "(1/n) * sum_{t=k..n-1}[(d_t-dbar)*(d_{t-k}-dbar)]",
      "long_run_variance": "gamma_0 + 2*sum_{k=1..19}[(1-k/20)*gamma_k]",
      "standard_error_mean": "sqrt(long_run_variance/n)",
      "test_statistic": "dbar / standard_error_mean",
      "one_sided_p_value": "1 - standard_normal_cdf(test_statistic)",
      "null": "mean_loss_differential <= 0",
      "alternative": "mean_loss_differential > 0",
      "alpha": 0.05,
      "degenerate_nonpositive_long_run_variance": "INCONCLUSIVE_IF_MEAN_POSITIVE; FAIL_NO_INCREMENTAL_INFORMATION_IF_MEAN_NONPOSITIVE"
