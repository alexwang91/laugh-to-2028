{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_exposure_registry.schema.json",
  "title": "Dataset Exposure Registry v1",
  "type": "object",
  "required": ["schema_version", "registry_id", "research_governance_version", "dataset_slices", "exposure_events"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "DATASET-EXPOSURE-REGISTRY-V1"},
    "research_governance_version": {"const": 1},
    "dataset_slices": {"type": "array", "items": {"$ref": "#/$defs/dataset_slice"}},
    "exposure_events": {"type": "array", "items": {"$ref": "#/$defs/exposure_event"}}
  },
  "additionalProperties": false,
  "$defs": {
    "dataset_slice": {
      "type": "object",
      "required": ["dataset_slice_id", "dataset_id", "dataset_version", "source", "assets", "fields", "resolution", "start", "end", "transformation", "pit_publication_semantics", "data_budget", "contamination_state", "consumed"],
      "properties": {
        "dataset_slice_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "assets": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}]},
        "fields": {"oneOf": [{"type": "array", "items": {"type": "string"}}, {"type": "string"}]},
        "resolution": {"type": "string"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "transformation": {"type": "string"},
        "pit_publication_semantics": {"type": "string"},
        "data_budget": {"enum": ["DEVELOPMENT", "VALIDATION", "SEALED", "TEMPORALLY_UNSEEN"]},
        "contamination_state": {"enum": ["DATA_SEALED", "OUTPUT_BLINDED", "RESEARCHER_EXPOSED_HISTORY", "TEMPORALLY_UNSEEN"]},
        "consumed": {"type": "boolean"},
        "researcher_exposed_history": {"type": "boolean"},
        "provenance_status": {"enum": ["FACT", "INFERRED_FROM_REPOSITORY", "UNKNOWN"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "exposure_event": {
      "type": "object",
      "required": ["exposure_id", "research_id", "dataset_slice_ref", "timestamp", "release_type", "result_informed_followup", "provenance_status"],
      "properties": {
        "exposure_id": {"type": "string", "minLength": 1},
        "research_id": {"type": "string", "minLength": 1},
        "dataset_slice_ref": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string"},
        "release_type": {"enum": ["PASS_FAIL_ONLY", "PRIMARY_METRIC_ONLY", "PREDECLARED_METRIC_SET", "EVENT_SUMMARY", "FULL_TABLE", "EQUITY_CURVE", "RAW_DATA", "UNKNOWN"]},
        "result_informed_followup": {"oneOf": [{"type": "boolean"}, {"enum": ["UNKNOWN", "NOT_HISTORICALLY_RECORDED"]}]},
        "provenance_status": {"enum": ["FACT", "INFERRED_FROM_REPOSITORY", "UNKNOWN"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
