# Safe defaults
HL_NETWORK=testnet
TRADING_MODE=shadow
COIN=BTC

# Account. Use the MASTER account address, never the API wallet address.
HL_MASTER_ADDRESS=
# Optional subaccount address. Leave blank for the default account.
HL_VAULT_ADDRESS=
# Add only in Vercel Environment Variables. Never commit or send this key in chat.
HL_API_PRIVATE_KEY=

# External holdings included in total strategy NAV.
EXTERNAL_SPOT_BTC_QTY=0
EXTERNAL_CASH_USD=0

REBALANCE_BAND=0.05
MIN_TRADE_USD=100
NORMAL_BETA_CAP=1.30
HARD_BETA_CAP=1.50
ALLOW_STRONG_BETA=false
MAX_PLATFORM_LEVERAGE=2
MAX_SLIPPAGE_BPS=15
CANDLE_LOOKBACK_DAYS=450
REQUEST_TIMEOUT_SECONDS=15

# Required before trade mode. Use at least 16 random characters.
CRON_SECRET=
# Required only for MAINNET trade mode.
LIVE_TRADING_CONFIRMATION=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
