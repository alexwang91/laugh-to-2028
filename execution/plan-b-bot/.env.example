# Safe defaults
HL_NETWORK=testnet
TRADING_MODE=shadow
COIN=BTC

# Account. Use the MASTER account address, never the API wallet address.
HL_MASTER_ADDRESS=
# Optional subaccount address. Leave blank for the default account.
HL_VAULT_ADDRESS=
# Add only in encrypted deployment environment variables. Never commit or send this key in chat.
HL_API_PRIVATE_KEY=

# Persistent execution truth. Trade mode requires an explicitly durable mounted path.
# The current SQLite backend is not permitted for trade mode on Vercel's function filesystem.
ORDER_LEDGER_PATH=/data/order-ledger.sqlite3
# Keep false unless /data (or the configured parent) is backed by persistent storage.
ORDER_LEDGER_DURABLE_STORAGE=false
# Optional explicit persistent path for the disable-new-risk kill switch.
# Defaults to ORDER_LEDGER_PATH + .new-risk-disabled when blank.
NEW_RISK_KILL_SWITCH_PATH=

# Direct emergency command entrypoint: python emergency_once.py
# cancel-all | reduce-only-close | emergency-flat | disable-new-risk
EMERGENCY_ACTION=
EMERGENCY_REASON=operator_emergency_switch

# External holdings included in total strategy NAV.
EXTERNAL_SPOT_BTC_QTY=0
EXTERNAL_CASH_USD=0

# Legacy BTC-only service controls. Canonical P3.3 reads config/rebalance_policy.json;
# its 0.05 L1 band preserves the existing execution-control continuity value.
REBALANCE_BAND=0.05
# Downstream order-feasibility threshold only. It is not a P3.3 portfolio rebalance gate.
MIN_TRADE_USD=100
# Legacy execution signal cap only. Values above 1.30 are forbidden until the registered P4 leverage study.
NORMAL_BETA_CAP=1.30
MAX_PLATFORM_LEVERAGE=2
MAX_SLIPPAGE_BPS=15
CANDLE_LOOKBACK_DAYS=450
REQUEST_TIMEOUT_SECONDS=15

# Required for every HTTP /api/cron invocation, including shadow mode.
# CLI/emergency entrypoints do not depend on this secret.
CRON_SECRET=
# Required only for MAINNET trade mode.
LIVE_TRADING_CONFIRMATION=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
